{
  "name": "{{name}}",
  "version": "0.0.0",
  "private": true,
  "bin": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.tsx --outdir dist --target bun --packages external",
    "dev": "bun --watch src/index.tsx",
    "start": "bun src/index.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.5.8",
    "@opentui/react": "0.5.8",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
