{
  "name": "termcn",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build --filter=web",
    "start": "turbo run start --filter=web",
    "typecheck": "turbo run typecheck",
    "examples:build": "turbo run examples:build --filter=web",
    "registry:build": "turbo run registry:build --filter=web",
    "registry:sync": "pnpm --filter=web registry:sync",
    "registry:validate": "pnpm --filter=web registry:validate",
    "docs:ink-v1": "pnpm --filter=web docs:ink-v1",
    "test": "pnpm test:ink && pnpm test:registry",
    "test:dither": "pnpm --filter=web test:dither",
    "test:ink": "pnpm --filter=web test:ink",
    "test:registry": "pnpm --filter=web test:registry",
    "check": "ultracite check && pnpm typecheck && pnpm registry:validate && pnpm test",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.4",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "turbo": "^2.10.2",
    "typescript": "^6",
    "ultracite": "7.6.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
